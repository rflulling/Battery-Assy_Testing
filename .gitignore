# .gitignore for PlatformIO Project

# PlatformIO
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/extensions.json

# Build artifacts
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.out
*.app
*.bin
*.elf
*.hex

# Dependencies (ignore lib contents but keep README)
lib/*
!lib/README.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# OS
Thumbs.db
Desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.old
.cache/
